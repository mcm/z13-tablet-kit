#!/bin/bash
# Hyprland variant of dock. Applies a desktop / laptop / tablet posture supplied
# by z13-tablet-switch, with the same interface as the Plasma dock:
#
#   dock {desktop|laptop|tablet} [disable-touch-in-desktop]
#
# - Touchscreen: off in desktop posture (unless the setting says otherwise).
# - Internal panel: rotation resets to normal outside tablet; scale can follow
#   posture if you set per-posture scales (off by default, so Omarchy's scaling
#   keys stay in charge).
# - Auto-rotate (iio-hyprland) and the on-screen keyboard (wvkbd) run only in tablet.
#
# Works with both config providers: the Lua config (Hyprland 0.55+, Omarchy 4),
# where changes go through `hyprctl eval`, and the classic hyprland.conf, where
# they go through `hyprctl keyword`.
#
# z13-tablet-switch re-runs this every 5 minutes for recovery, so every step is
# idempotent, and display changes happen only on a real posture change (or after
# Hyprland restarts) so a periodic re-run never fights iio-hyprland's rotation.
set -u

RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/z13-tablet-kit"
STATEF="$RUNDIR/posture"
APPLIEDF="$RUNDIR/hyprland-applied"
UID_NUM=$(id -u)

# Defaults. Override any of these in ~/.config/z13-tablet-kit/hyprland.env.
Z13_MONITOR=eDP-1
Z13_MODE=preferred
Z13_SCALE_DESKTOP=
Z13_SCALE_LAPTOP=
Z13_SCALE_TABLET=
# Prefer the omarchy-rog-z13-setup wrapper (suppresses a libdbus abort on exit).
if [ -x "$HOME/.local/bin/iio-hyprland" ]; then
	Z13_ROTATE_CMD="$HOME/.local/bin/iio-hyprland"
else
	Z13_ROTATE_CMD=iio-hyprland
fi
Z13_ROTATE_PROC=iio-hyprland
if command -v wvkbd-deskintl >/dev/null 2>&1; then
	Z13_OSK_CMD="wvkbd-deskintl --hidden -L 300"
	Z13_OSK_PROC=wvkbd-deskintl
else
	Z13_OSK_CMD="wvkbd-mobintl --hidden"
	Z13_OSK_PROC=wvkbd-mobintl
fi
Z13_TOUCH_MATCH=elan9008
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/z13-tablet-kit/hyprland.env"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

case "${1-}" in
	desktop|laptop|tablet) state=$1 ;;
	*) echo "usage: dock {desktop|laptop|tablet} [disable-touch-in-desktop]" >&2; exit 2 ;;
esac
case "${2-true}" in
	true|false) disable_touch_in_desktop=${2-true} ;;
	*) echo "dock: disable-touch-in-desktop must be true or false" >&2; exit 2 ;;
esac

mkdir -p "$RUNDIR"
chmod 700 "$RUNDIR"
prev=$(cat "$STATEF" 2>/dev/null || true)

# A systemd user service may start before uwsm exports Hyprland's environment.
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	# Newest instance first; instance signatures never contain spaces.
	# shellcheck disable=SC2045
	for d in $(ls -td "${XDG_RUNTIME_DIR:-/run/user/$UID_NUM}"/hypr/*/ 2>/dev/null); do
		if [ -S "$d/.socket.sock" ]; then
			HYPRLAND_INSTANCE_SIGNATURE=$(basename "$d")
			export HYPRLAND_INSTANCE_SIGNATURE
			break
		fi
	done
fi
if ! hyprctl version >/dev/null 2>&1; then
	echo "dock: Hyprland unavailable" >&2
	exit 1
fi

# The Lua provider is active exactly when hyprland.lua exists.
LUA=false
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" ] && LUA=true

# Run hyprctl and require its "ok" reply (eval and keyword both answer "ok").
hypr_ok() {
	local out
	out=$(hyprctl "$@" 2>&1)
	if [ "$out" != ok ]; then
		echo "dock: hyprctl $1 failed: $out" >&2
		return 1
	fi
}

# Start a program as a child of Hyprland, so it gets the session environment
# and outlives this service.
hypr_exec() {
	if [ "$LUA" = true ]; then
		hyprctl dispatch "hl.dsp.exec_cmd([[$1]])" >/dev/null 2>&1
	else
		hyprctl dispatch exec "$1" >/dev/null 2>&1
	fi
}

# --- touchscreen ---------------------------------------------------------------
touch_name=$(hyprctl devices -j 2>/dev/null | Z13_TOUCH_MATCH="$Z13_TOUCH_MATCH" python3 -c '
import json, os, sys
match = os.environ["Z13_TOUCH_MATCH"].lower()
try:
    devices = json.load(sys.stdin).get("touch", [])
except ValueError:
    devices = []
for d in devices:
    name = d.get("name", "")
    if match in name.lower() and "stylus" not in name.lower():
        print(name)
        break
')
if [ -z "$touch_name" ]; then
	echo "dock: touchscreen unavailable" >&2
	exit 1
fi
want=true
if [ "$state" = desktop ] && [ "$disable_touch_in_desktop" = true ]; then want=false; fi
if [ "$LUA" = true ]; then
	hypr_ok eval "hl.device({ name = \"$touch_name\", enabled = $want })" || exit 1
else
	hypr_ok keyword "device[$touch_name]:enabled" "$want" || exit 1
fi

# --- internal panel: scale and rotation (only on a real change) -----------------
key="$state $HYPRLAND_INSTANCE_SIGNATURE"
if [ "$(cat "$APPLIEDF" 2>/dev/null)" != "$key" ]; then
	case "$state" in
		desktop) scale=$Z13_SCALE_DESKTOP ;;
		laptop)  scale=$Z13_SCALE_LAPTOP ;;
		tablet)  scale=$Z13_SCALE_TABLET ;;
	esac
	# Current position, scale and transform of the panel: "x y scale transform".
	read -r mx my mscale mtransform < <(hyprctl monitors -j 2>/dev/null | \
		Z13_MONITOR="$Z13_MONITOR" python3 -c '
import json, os, sys
try:
    monitors = json.load(sys.stdin)
except ValueError:
    monitors = []
for m in monitors:
    if m.get("name") == os.environ["Z13_MONITOR"]:
        print(m["x"], m["y"], m["scale"], m["transform"])
        break
')
	if [ -z "${mx:-}" ]; then
		echo "dock: monitor $Z13_MONITOR unavailable" >&2
		exit 1
	fi
	# Empty setting = keep the current scale. Hyprland has no field-level merge,
	# so the monitor rule always carries an explicit scale.
	[ -n "$scale" ] || scale=$mscale
	if [ "$state" = tablet ]; then
		transform=$mtransform  # keep it; iio-hyprland owns rotation in tablet
	else
		pkill -u "$UID_NUM" -x "$Z13_ROTATE_PROC" >/dev/null 2>&1 || true
		transform=0
	fi
	if [ "$LUA" = true ]; then
		lua="hl.monitor({ output = \"$Z13_MONITOR\", mode = \"$Z13_MODE\", position = \"${mx}x${my}\", scale = $scale, transform = $transform })"
		if [ "$state" != tablet ]; then
			lua="$lua; hl.config({ input = { touchdevice = { transform = 0 }, tablet = { transform = 0 } } })"
		fi
		hypr_ok eval "$lua" || exit 1
	else
		hypr_ok keyword monitor "$Z13_MONITOR,$Z13_MODE,${mx}x${my},$scale,transform,$transform" || exit 1
		if [ "$state" != tablet ]; then
			hypr_ok keyword input:touchdevice:transform 0 || exit 1
			hypr_ok keyword input:tablet:transform 0 || exit 1
		fi
	fi
	printf '%s\n' "$key" > "$APPLIEDF"
fi

# --- tablet-only helpers (ensured on every run, so they come back after a crash) ---
if [ "$state" = tablet ]; then
	if [ -n "$Z13_ROTATE_CMD" ] && ! pgrep -u "$UID_NUM" -x "$Z13_ROTATE_PROC" >/dev/null 2>&1; then
		hypr_exec "$Z13_ROTATE_CMD"
	fi
	if [ -n "$Z13_OSK_CMD" ] && ! pgrep -u "$UID_NUM" -x "$Z13_OSK_PROC" >/dev/null 2>&1; then
		hypr_exec "$Z13_OSK_CMD"
	fi
else
	pkill -u "$UID_NUM" -x "$Z13_ROTATE_PROC" >/dev/null 2>&1 || true
	pkill -u "$UID_NUM" -x "$Z13_OSK_PROC" >/dev/null 2>&1 || true
fi

# --- publish posture (z13-touch-scroll reads this) -------------------------------
tmp="$STATEF.tmp.$$"
if ! printf '%s\n' "$state" > "$tmp" || ! mv -f "$tmp" "$STATEF"; then
	rm -f "$tmp"
	echo "dock: $state pending (posture state write failed, touch=$want)" >&2
	exit 1
fi
if [ "$prev" != "$state" ]; then
	echo "dock: $state (touch=$want)"
fi
