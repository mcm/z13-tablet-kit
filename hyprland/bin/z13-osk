#!/bin/bash
# Toggle the on-screen keyboard. Bind it in Hyprland. Lua config (Omarchy 4):
#   o.bind("SUPER + CTRL + K", "Virtual keyboard", os.getenv("HOME") .. "/.local/bin/z13-osk")
# hyprland.conf:
#   bind = SUPER CTRL, K, exec, z13-osk
# (omarchy-rog-z13-setup's z13.lua binds SUPER+V to this automatically.)
#
# In tablet posture dock keeps wvkbd running hidden, so this just shows/hides it.
# Outside tablet posture it starts a visible keyboard (dock closes it again on
# the next posture change).
set -u
if command -v wvkbd-deskintl >/dev/null 2>&1; then
	Z13_OSK_CMD="wvkbd-deskintl --hidden -L 300"
	Z13_OSK_PROC=wvkbd-deskintl
else
	Z13_OSK_CMD="wvkbd-mobintl --hidden"
	Z13_OSK_PROC=wvkbd-mobintl
fi
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/z13-tablet-kit/hyprland.env"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

pids=$(pgrep -u "$(id -u)" -x "$Z13_OSK_PROC")
if [ -n "$pids" ]; then
	# wvkbd: SIGUSR1 hides, SIGUSR2 shows, SIGRTMIN toggles.
	# shellcheck disable=SC2086
	kill -s RTMIN $pids
	exit 0
fi

# Start shown: drop --hidden from the configured command.
cmd=${Z13_OSK_CMD//--hidden/}
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" ]; then
	[ "$(hyprctl dispatch "hl.dsp.exec_cmd([[$cmd]])" 2>&1)" = ok ] && exit 0
else
	[ "$(hyprctl dispatch exec "$cmd" 2>&1)" = ok ] && exit 0
fi
# shellcheck disable=SC2086
setsid -f $cmd >/dev/null 2>&1
