# z13-tablet-kit, Hyprland variant: optional overrides.
# Copied to ~/.config/z13-tablet-kit/hyprland.env on first install.
# Changes apply on the next posture change.

# Internal panel and its mode.
#Z13_MONITOR=eDP-1
#Z13_MODE=highrr

# Panel scale per posture. Must divide 2560x1600 evenly (1.25, 1.6, 2 work).
# Leave a value empty to keep whatever scale the panel already has.
#Z13_SCALE_DESKTOP=1.6
#Z13_SCALE_LAPTOP=1.6
#Z13_SCALE_TABLET=2

# Auto-rotate daemon, run only in tablet posture. Empty disables it.
#Z13_ROTATE_CMD=iio-hyprland
#Z13_ROTATE_PROC=iio-hyprland

# On-screen keyboard, kept running (hidden) only in tablet posture.
# Toggle it with z13-osk. Empty disables it.
#Z13_OSK_CMD="wvkbd-mobintl --hidden"
#Z13_OSK_PROC=wvkbd-mobintl
