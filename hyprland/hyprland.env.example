# z13-tablet-kit, Hyprland variant: optional overrides.
# Copied to ~/.config/z13-tablet-kit/hyprland.env on first install.
# Changes apply on the next posture change.

# Internal panel and its mode.
#Z13_MONITOR=eDP-1
#Z13_MODE=preferred

# Panel scale per posture. Empty (the default) keeps whatever scale the panel
# already has, so Omarchy's scaling keys (SUPER+SLASH) stay in charge.
# Values must divide 2560x1600 evenly (1.25, 1.6, 2 work; 1.75 doesn't).
#Z13_SCALE_DESKTOP=
#Z13_SCALE_LAPTOP=
#Z13_SCALE_TABLET=2

# Auto-rotate daemon, run only in tablet posture. Empty disables it.
# Default: ~/.local/bin/iio-hyprland (omarchy-rog-z13-setup's wrapper) if
# present, else iio-hyprland from PATH.
#Z13_ROTATE_CMD=iio-hyprland
#Z13_ROTATE_PROC=iio-hyprland

# On-screen keyboard, kept running (hidden) only in tablet posture; toggle it
# with z13-osk. Empty disables it. Default: wvkbd-deskintl if installed, else
# wvkbd-mobintl.
#Z13_OSK_CMD="wvkbd-deskintl --hidden -L 300"
#Z13_OSK_PROC=wvkbd-deskintl
